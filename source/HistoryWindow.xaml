<ui:FluentWindow
    x:Class="SplashBot_2.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SplashBot_2"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:us="clr-namespace:Unsplasharp.Models;assembly=Unsplasharp"
    Title="Photo History"
    Width="800"
    Height="450"
    d:DataContext="{d:DesignInstance local:PhotoHistoryViewModel}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Default"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <!--  titlebar  -->
            <RowDefinition Height="auto" />
            <!--  content  -->
            <RowDefinition />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
            x:Name="TitleBar"
            Title="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=Title}"
            CloseWindowByDoubleClickOnIcon="True"
            ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/SplashBot_2;component/base-icon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1"
            Margin="24"
            Background="{StaticResource BackgroundDark}">
            <ListBox
                Grid.IsSharedSizeScope="True"
                ItemsSource="{Binding Photos}"
                ScrollViewer.CanContentScroll="False">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type us:Photo}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition
                                    Width="200"
                                    SharedSizeGroup="col1" />
                                <ColumnDefinition SharedSizeGroup="col2" />
                            </Grid.ColumnDefinitions>

                            <ui:Image Grid.Column="0"
                                Width="100"
                                HorizontalAlignment="Left"
                                CornerRadius="4"
                                Source="{Binding Urls.Small}"
                                Stretch="Fill" />

                            <TextBlock Grid.Column="1"
                                Text="{Binding User.Name}" />
                            <TextBlock Grid.Column="2"
                                Text="{Binding Description}" />

                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

    </Grid>
</ui:FluentWindow>
